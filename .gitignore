# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Pytest/cache
.pytest_cache/
.coverage
htmlcov/

# Virtual environment
.venv/
venv/
env/

# Build/dist
build/
dist/
*.egg-info/

# Local temp/output
tmp/

# Runtime logs. The logger recreates logs/ on start, so nothing here belongs
# in git. A log kept deliberately as a test fixture goes under tests/fixtures.
logs/
*.log
# Local Claude Code settings
.claude/

# Frontend build and dependency artifacts
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/*.tsbuildinfo
apps/web/.env.local

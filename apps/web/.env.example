# Public configuration for the AQOS web frontend.
#
# Every value here reaches the browser. Nothing secret belongs in this file:
# no database URL, no API token, no credential of any kind. The frontend
# authenticates as a user through the AQOS login endpoint and holds nothing
# the server has not already handed that user.
NEXT_PUBLIC_AQOS_WEB_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AQOS_WEB_APP_NAME=AQOS
NEXT_PUBLIC_AQOS_WEB_ENV=development
